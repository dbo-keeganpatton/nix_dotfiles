# Zen Browser additions for nixos/configuration.nix
# Source: https://wiki.nixos.org/wiki/Zen_Browser

# ---- 1. Add to the `let` block (near the herdr binding) ----

  zen-browser = (builtins.getFlake "github:youwen5/zen-browser-flake")
    .packages.${pkgs.system}.default;


# ---- 2. Add to environment.systemPackages ----

    zen-browser                   # Zen Browser
